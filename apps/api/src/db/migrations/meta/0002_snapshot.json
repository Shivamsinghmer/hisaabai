  "views": {
    "public.customer_balances": {
      "columns": {
        "customer_id": {
          "name": "customer_id",
          "type": "uuid",
          "primaryKey": false,
          "notNull": true
        },
        "merchant_id": {
          "name": "merchant_id",
          "type": "uuid",
          "primaryKey": false,
          "notNull": true
        },
        "name": {
          "name": "name",
          "type": "text",
          "primaryKey": false,
          "notNull": true
        },
        "balance_paise": {
          "name": "balance_paise",
          "type": "bigint",
          "primaryKey": false,
          "notNull": true
        },
        "earliest_due": {
          "name": "earliest_due",
          "type": "date",
          "primaryKey": false,
          "notNull": false
        }
      },
      "definition": "\n  with totals as (\n    select c.id as customer_id, c.merchant_id, c.name,\n      coalesce(sum(e.amount_paise) filter (where e.type = 'credit'), 0)::bigint as credited,\n      coalesce(sum(e.amount_paise) filter (where e.type = 'payment'), 0)::bigint as paid\n    from customers c\n    left join ledger_entries e on e.customer_id = c.id and e.status = 'confirmed'\n    group by c.id\n  ),\n  running as (\n    select e.customer_id, e.due_date,\n      sum(e.amount_paise) over (\n        partition by e.customer_id order by e.entry_date, e.created_at, e.id\n      ) as credited_so_far\n    from ledger_entries e\n    where e.type = 'credit' and e.status = 'confirmed'\n  ),\n  oldest_unpaid as (\n    select r.customer_id, min(r.due_date) as earliest_due\n    from running r join totals t using (customer_id)\n    where r.credited_so_far > t.paid\n    group by r.customer_id\n  )\n  select t.customer_id, t.merchant_id, t.name,\n    (t.credited - t.paid)::bigint as balance_paise,\n    o.earliest_due\n  from totals t left join oldest_unpaid o using (customer_id)\n",
      "name": "customer_balances",
      "schema": "public",
      "isExisting": false,
      "materialized": false
    }
  },
