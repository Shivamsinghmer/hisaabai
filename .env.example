# Copy to .env.local (repo root). Neon values come from `neon env pull` / `neon deploy`.

# Core (don't set NODE_ENV here: Next.js sets it per command, and the API defaults to development)
PORT=4000
WEB_ORIGIN=http://localhost:3000
API_URL=http://localhost:4000

# Neon Postgres (pooled for the app, unpooled/direct for migrations)
DATABASE_URL=
DATABASE_URL_UNPOOLED=
NEON_BRANCH=

# Neon Auth (managed Better Auth)
NEON_AUTH_BASE_URL=
NEON_AUTH_JWKS_URL=
# 32+ random bytes, base64: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
NEON_AUTH_COOKIE_SECRET=

# Demo (pnpm seed:demo): links "Sharma General Store" to these Neon Auth accounts
# (comma-separated) so they can log in as Ramesh. Sign up on the same branch first.
DEMO_OWNER_EMAIL=

# Upstash Redis (TLS endpoint, rediss://default:<token>@<host>:6379)
REDIS_URL=

# Storage (local disk in dev; Supabase Storage later)
UPLOAD_DIR=./uploads
STORAGE_BUCKET_URL=
STORAGE_KEY=

# AI
AI_MOCK=true
SARVAM_API_KEY=
SARVAM_STT_MODEL=
SARVAM_TTS_MODEL=
SARVAM_TTS_VOICE=
GROQ_API_KEY=
GROQ_TEXT_MODEL=
GROQ_VISION_MODEL=
AI_CACHE_TTL_SECONDS=604800

# Payments: PAYTM_MODE=mock (default, in-app /pay/:token page) | staging (Paytm test gateway)
PAYTM_MODE=mock
PAY_LINK_BASE_URL=http://localhost:3000/pay
# Paytm staging (only used when PAYTM_MODE=staging). MID + merchant key from the
# Paytm dashboard → API Keys (test mode). The merchant key is secret: server only.
PAYTM_HOST=https://securegw-stage.paytm.in
PAYTM_MID=
PAYTM_MERCHANT_KEY=

# Optional WhatsApp test number
WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=

# Web
NEXT_PUBLIC_API_URL=http://localhost:4000
