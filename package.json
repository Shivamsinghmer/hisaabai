{
  "name": "hisaab-ai",
  "private": true,
  "packageManager": "pnpm@10.19.0",
  "engines": {
    "node": ">=22.20"
  },
  "scripts": {
    "dev": "pnpm --filter @hisaab/shared build && pnpm -r --parallel dev",
    "build": "pnpm -r build",
    "start": "pnpm -r --parallel start",
    "typecheck": "pnpm --filter @hisaab/shared build && pnpm -r typecheck",
    "test": "pnpm -r test",
    "db:generate": "pnpm --filter @hisaab/api db:generate",
    "db:migrate": "pnpm --filter @hisaab/api db:migrate",
    "db:migrate:test": "pnpm --filter @hisaab/api db:migrate:test",
    "seed": "pnpm --filter @hisaab/shared build && pnpm --filter @hisaab/api seed",
    "seed:demo": "pnpm --filter @hisaab/shared build && pnpm --filter @hisaab/api seed:demo",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "demo:smoke": "pnpm seed:demo && pnpm --filter @hisaab/api demo:smoke && pnpm --filter @hisaab/api seed:demo"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@neon/config": "^1.10.0",
    "@neon/env": "^1.6.8",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.3",
    "globals": "17.13.0",
    "prettier": "3.9.10",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.1"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@tailwindcss/oxide",
      "esbuild",
      "sharp",
      "unrs-resolver"
    ]
  }
}
